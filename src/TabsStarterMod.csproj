    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>TabsStarterMod</AssemblyName>
    <RootNamespace>TabsStarterMod</RootNamespace>
    <OutputPath>../build/</OutputPath>
